# Port du serveur
PORT=3000

# Mode de connexion au CRA :
#   local -> les CRA sont stockés dans la base SQLite de l'application (défaut)
#   http  -> les CRA sont lus/écrits via l'API de votre CRA maison
CRA_MODE=local

# Utilisé uniquement si CRA_MODE=http
CRA_API_URL=https://cra.votre-esn.fr/api
CRA_API_TOKEN=remplacez-moi
